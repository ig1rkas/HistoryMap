{
    "use": true,
    "method": "get",

    "params": [
        { "name": "place_id", "type": "objectId", "required": true, "description": "ObjectId достопримечательности" },
        { "name": "limit", "type": "number", "required": false, "interval": [1, 100] },
        { "name": "offset", "type": "number", "required": false, "orientation": "positive" }
    ],

    "openapi": {
        "summary": "Список отзывов по месту",
        "description": "Только approved-отзывы, сортировка по created_at desc, пагинация через limit/offset.",
        "tags": [ "reviews" ],
        "response_schema": {
            "type": "object",
            "properties": {
                "reviews": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "_id": { "type": "string" },
                            "place_id": { "type": "string" },
                            "author_id": { "type": "string" },
                            "rating": { "type": "integer" },
                            "text": { "type": "string", "nullable": true },
                            "moderation_status": { "type": "string" },
                            "created_at": { "type": "string" },
                            "updated_at": { "type": "string" },
                            "author": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                    "_id": { "type": "string" },
                                    "vk_id": { "type": "number" },
                                    "first_name": { "type": "string", "nullable": true },
                                    "last_name": { "type": "string", "nullable": true },
                                    "avatar": { "type": "string", "nullable": true }
                                }
                            }
                        }
                    }
                },
                "total": { "type": "integer" },
                "limit": { "type": "integer" },
                "offset": { "type": "integer" }
            }
        }
    }
}
