# Сервер
PORT=3000
# Внешний порт при запуске через docker-compose (маппится на PORT внутри контейнера)
API_PORT=3000
CORS_ORIGIN=*

# MongoDB: для локального запуска — полная строка подключения.
# При docker-compose MONGO_URL переопределяется на основе MONGO_USER/MONGO_PASSWORD.
MONGO_URL=mongodb://localhost:27017/history_map

# MongoDB credentials (используются только docker-compose для контейнера mongo и сборки MONGO_URL для api)
# Только алфавитно-цифровые символы, чтобы не экранировать в URL
MONGO_USER=admin
MONGO_PASSWORD=

# JWT (заполни рандомными длинными строками)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# VK ID (заполнится после регистрации приложения)
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=
